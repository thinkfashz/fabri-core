{
  "$schema": "https://json.schemastore.org/package",
  "version": "1.0.0",
  "brand": "FABRI-CORE PRO",
  "description": "Sistema de diseño canónico de FABRI-CORE PRO. Fuente única de verdad para WEB y APP ANDROID.",
  "tokens": {
    "colores": {
      "principal": {
        "negro": "#050505",
        "negro_mate": "#0B0B0B",
        "lima": "#C8FF00",
        "lima_alternativo": "#B7FF32",
        "blanco": "#FFFFFF"
      },
      "semanticos": {
        "fondo": "#050505",
        "fondo_alt": "#0B0B0B",
        "superficie": "#0B0B0B",
        "texto_principal": "#FFFFFF",
        "texto_secundario": "#B7FF32",
        "texto_sobre_lima": "#050505",
        "borde": "#1A1A1A",
        "sombra": "rgba(0, 0, 0, 0.4)",
        "estado_activo": "#C8FF00",
        "estado_inactivo": "#333333",
        "estado_alerta": "#FF3B30",
        "estado_exito": "#34C759"
      }
    },
    "tipografia": {
      "familia_principal": "Inter",
      "pesos": {
        "regular": 400,
        "medio": 500,
        "semibold": 600,
        "bold": 700
      },
      "escalas": {
        "h1_escritorio": "48px",
        "h1_movil": "32px",
        "h2_escritorio": "32px",
        "h2_movil": "24px",
        "texto_normal": "16px",
        "etiqueta": "12px",
        "boton": "14px"
      },
      "espaciado_letras": {
        "etiqueta": "0.08em",
        "titulo": "-0.02em"
      },
      "altura_linea": {
        "cuerpo": 1.5,
        "titulo": 1.2
      }
    },
    "espaciado": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "xxl": "48px",
      "seguridad_logo": "12%"
    },
    "radios": {
      "boton": "12px",
      "input": "12px",
      "tarjeta": "12px",
      "modal": "12px",
      "pill": "20px",
      "circulo": "50%"
    },
    "sombras": {
      "sutil": "0 2px 8px rgba(0, 0, 0, 0.3)",
      "media": "0 4px 16px rgba(0, 0, 0, 0.4)",
      "fuente": "0 0 20px rgba(200, 255, 0, 0.15)"
    },
    "transiciones": {
      "rapida": "150ms ease",
      "normal": "300ms ease",
      "lenta": "500ms ease"
    },
    "bordes": {
      "grosor": "1px",
      "color": "#1A1A1A",
      "color_enfoque": "#C8FF00"
    },
    "objetivos_tactiles": {
      "minimo": "44x44px",
      "recomendado": "48x48px"
    },
    "loader": {
      "duracion_ms": 2500,
      "fondo": "#050505",
      "acento": "#C8FF00",
      "monograma": "F",
      "tipografia": "Inter"
    }
  },
  "reglas": {
    "lima": "Color de acento funcional. Solo para estados activos, progreso, datos importantes y acciones principales. Nunca rellenar toda la interfaz.",
    "logotipo": "Monograma F geométrico original. No deformar, no agregar gradientes, no agregar sombras. Espacio de seguridad 12%.",
    "fondos": "Sólidos como tratamiento predeterminado. Retícula blueprint sutil opcional para contexto técnico.",
    "web": "Navegación lateral en escritorio, responsive en móvil. No copiar layout de Android.",
    "android": "Borde a borde, barras compactas, controles para el pulgar. No comprimir web como APK.",
    "accesibilidad": "Contraste mínimo 4.5:1, objetivos táctiles 44px+, foco visible, reducir movimiento."
  }
}
