{
  "version": 2,
  "builds": [
    {
      "src": "api/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/think",
      "dest": "/api/think.ts"
    },
    {
      "src": "/api/sync",
      "dest": "/api/sync.ts"
    },
    {
      "src": "/api/stats",
      "dest": "/api/stats.ts"
    },
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.ts"
    },
    {
      "src": "/api/diagnostico",
      "dest": "/api/diagnostico.ts"
    },
    {
      "src": "/api/agente",
      "dest": "/api/agente.ts"
    },
    {
      "src": "/api/modelos",
      "dest": "/api/agente.ts"
    },
    {
      "src": "/api/memoria",
      "dest": "/api/agente.ts"
    },
    {
      "src": "/api/skills",
      "dest": "/api/agente.ts"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/api/estado",
      "dest": "/api/estado.ts"
    },
    {
      "src": "/api/inventario",
      "dest": "/api/inventario.ts"
    },
    {
      "src": "/api/catalogo",
      "dest": "/api/catalogo.ts"
    },
    {
      "src": "/api/mercado",
      "dest": "/api/mercado.ts"
    },
    {
      "src": "/api/visitas",
      "dest": "/api/visitas.ts"
    }
  ]
}
