<?xml version="1.0" encoding="utf-8"?>
<!--
  FABRI-CORE · manifiesto de la APK
  Fase 3: se añade INTERNET porque la descarga de componentes ocurre dentro de la
  app. Toda descarga pasa por Descargador.java: HTTPS obligatorio, SHA-256 y
  tamaño verificados contra el manifiesto, y nada se instala si no coincide.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cl.fabrick.core"
    android:versionCode="43"
    android:versionName="0.9.28">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Cámara: sólo para leer códigos de barras del inventario. El WebView
         pide el permiso en el momento de abrir el escáner; nunca al arrancar. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Visibilidad de paquetes en Android 11+: Termux y el motor TTS. -->
    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/FabrickTheme"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:alwaysRetainTaskState="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Retorno de OAuth (GitHub, Google, Meta) con PKCE. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fabrickcore" android:host="oauth" />
            </intent-filter>
        </activity>

        <provider
            android:name=".ApkProvider"
            android:authorities="cl.fabrick.core.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
